{
  "id": "/",
  "name": "Tunemate — find friends through music",
  "short_name": "Tunemate",
  "description": "Match with people who share your music taste, play real songs, chat and play music games.",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#09090d",
  "theme_color": "#09090d",
  "categories": ["music", "social", "entertainment"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Discover matches", "short_name": "Discover", "url": "/?view=discover", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Chat with friends", "short_name": "Friends", "url": "/?view=friends", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Play games", "short_name": "Games", "url": "/?view=games", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
