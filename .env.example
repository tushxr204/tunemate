# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit a real .env file to GitHub.

# From Supabase → Project Settings → API (Data API)
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Optional: lets the app play FULL songs from YouTube inside the app.
# From Google Cloud Console → APIs & Services → Credentials (enable "YouTube Data API v3").
YOUTUBE_API_KEY=
